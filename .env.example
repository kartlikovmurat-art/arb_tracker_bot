## Скопируйте этот файл в .env и заполните реальные значения
## cp .env.example .env   (или copy .env.example .env на Windows)
##
## ⚠️  .env НИКОГДА не должен попадать в git. В репозитории уже
##     лежит .gitignore, который это гарантирует.

# ─────────────────────────────────────────────────────────────
# Telegram bot token
# Получите новый токен у @BotFather в Telegram:
#   /mybots  →  ваш бот  →  API Token
# Скопируйте строку вида:
#   1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# и вставьте сюда.
# ─────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# ─────────────────────────────────────────────────────────────
# База данных
# По умолчанию — локальный SQLite. Файл создаётся в корне проекта.
# Для PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# ─────────────────────────────────────────────────────────────
# URL FastAPI-сервиса, к которому бот стучится за сделками
# ─────────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:8000

# ─────────────────────────────────────────────────────────────
# Опционально: ваш Telegram user_id (число). Используйте, если
# планируете админ-команды. Чтобы узнать свой id, напишите
# боту @userinfobot в Telegram.
# ─────────────────────────────────────────────────────────────
ADMIN_ID=

# ─────────────────────────────────────────────────────────────
# Опционально: прокси для исходящих запросов к api.telegram.org.
# Оставьте пустым, если прокси не нужен.
# Форматы:
#   BOT_PROXY=http://user:pass@host:port
#   BOT_PROXY=socks5://user:pass@host:port   (нужен httpx[socks])
# ─────────────────────────────────────────────────────────────
BOT_PROXY=

# Уровень логирования бота: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Публичный HTTPS URL встроенной Mini App (тот же FastAPI-сервис)
# Пример: https://your-service.onrender.com/miniapp
MINI_APP_URL=

