## Copy this file to .env and fill the values
# Telegram bot token (required to run the bot)
BOT_TOKEN=your_bot_token_here

# Database URL. Default points to a local SQLite file using aiosqlite driver.
# Example: sqlite+aiosqlite:///./db.sqlite3
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# Optional admin user id for bot (numeric)
ADMIN_ID=

# Optional API URL for the FastAPI service
# Example: http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000